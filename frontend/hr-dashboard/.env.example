# API Gateway HTTP API's $default stage endpoint; do not add a /dev suffix.
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
VITE_DEMO_MODE=false

# Use the same Cognito user pool as the portal, with an allowed callback for port 5174.
# Configure OAuth authorization code grant with PKCE; do NOT create a client secret.
VITE_COGNITO_DOMAIN=https://your-prefix.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=replace-with-public-app-client-id
VITE_AUTH_REDIRECT_URI=http://localhost:5174/
VITE_LOGOUT_REDIRECT_URI=http://localhost:5174/
VITE_COGNITO_SCOPES=openid email profile
